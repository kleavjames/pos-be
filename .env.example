# Copy to .env and adjust if needed:
#   cp .env.example .env

# Postgres (used by docker-compose and your NestJS app)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pos_db
POSTGRES_PORT=5432

# NestJS database connection (when you wire up TypeORM/Prisma)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pos_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db
