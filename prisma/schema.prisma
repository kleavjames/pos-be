generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryPricingMode {
  SINGLE
  VARIANT
}

enum CategoryOptionType {
  SERVING_VARIANT
  ADDON
}

enum StaffRoleCode {
  ADMIN
  MANAGER
  CASHIER
}

enum FulfillmentType {
  WALK_IN
  PICKUP
  DELIVERY
}

model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff      Staff[]
  categories Category[]
  products   Product[]
  customers  Customer[]
  orders     Order[]
}

model Role {
  id   String        @id @default(cuid())
  code StaffRoleCode @unique
  name String

  staff Staff[]
}

model Staff {
  id           String   @id @default(cuid())
  businessId   String
  roleId       String
  email        String
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role          Role                 @relation(fields: [roleId], references: [id])
  orders        Order[]              @relation("OrderCreatedBy")
  statusChanges OrderStatusHistory[]

  @@unique([businessId, email])
  @@index([businessId])
}

model Category {
  id          String              @id @default(cuid())
  businessId  String
  name        String
  pricingMode CategoryPricingMode @default(VARIANT)
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  optionGroups CategoryOptionGroup[]
  products     Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

model CategoryOptionGroup {
  id         String             @id @default(cuid())
  categoryId String
  name       String
  type       CategoryOptionType
  sortOrder  Int                @default(0)

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options  CategoryOption[]

  @@unique([categoryId, name])
}

model CategoryOption {
  id           String  @id @default(cuid())
  groupId      String
  name         String
  defaultPrice Decimal @default(0) @db.Decimal(10, 2)
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  group          CategoryOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  productOptions ProductOption[]

  @@unique([groupId, name])
}

model Product {
  id         String   @id @default(cuid())
  businessId String
  categoryId String
  name       String
  basePrice  Decimal? @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productOptions ProductOption[]
  orderItems     OrderItem[]

  @@index([businessId, categoryId])
}

model ProductOption {
  id               String  @id @default(cuid())
  productId        String
  categoryOptionId String
  isEnabled        Boolean @default(true)
  price            Decimal @db.Decimal(10, 2)

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryOption CategoryOption @relation(fields: [categoryOptionId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryOptionId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([businessId, phone])
}

model OrderStatus {
  id         String  @id @default(cuid())
  code       String  @unique
  label      String
  sortOrder  Int
  isTerminal Boolean @default(false)
  isActive   Boolean @default(true)

  orders            Order[]
  transitionsFrom   OrderStatusTransition[] @relation("FromStatus")
  transitionsTo     OrderStatusTransition[] @relation("ToStatus")
  historyAsFrom     OrderStatusHistory[]    @relation("HistoryFromStatus")
  historyAsTo       OrderStatusHistory[]    @relation("HistoryToStatus")
}

model OrderStatusTransition {
  id           String @id @default(cuid())
  fromStatusId String
  toStatusId   String

  fromStatus OrderStatus @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   OrderStatus @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([fromStatusId, toStatusId])
}

model Order {
  id              String          @id @default(cuid())
  businessId      String
  customerId      String?
  createdById     String?
  statusId        String
  fulfillmentType FulfillmentType @default(DELIVERY)
  orderNumber     String

  customerName    String
  customerPhone   String?
  deliveryAddress String?

  isPaid Boolean   @default(false)
  paidAt DateTime?

  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)
  notes    String?

  placedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy Staff?               @relation("OrderCreatedBy", fields: [createdById], references: [id])
  status    OrderStatus          @relation(fields: [statusId], references: [id])
  items     OrderItem[]
  history   OrderStatusHistory[]

  @@unique([businessId, orderNumber])
  @@index([businessId, statusId])
  @@index([businessId, placedAt])
  @@index([businessId, isPaid])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  variantName String?
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id          String  @id @default(cuid())
  orderItemId String
  name        String
  price       Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model OrderStatusHistory {
  id           String   @id @default(cuid())
  orderId      String
  fromStatusId String?
  toStatusId   String
  changedById  String?
  note         String?
  createdAt    DateTime @default(now())

  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus? @relation("HistoryFromStatus", fields: [fromStatusId], references: [id])
  toStatus   OrderStatus  @relation("HistoryToStatus", fields: [toStatusId], references: [id])
  changedBy  Staff?       @relation(fields: [changedById], references: [id])

  @@index([orderId, createdAt])
}
